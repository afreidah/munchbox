{
  "run_list": [
    "recipe[pi_bootstrap::default]",
    "recipe[pi_bootstrap::firewall]",
    "recipe[pi_bootstrap::wireguard]",
    "recipe[pi_bootstrap::docker_setup]",
    "recipe[pi_bootstrap::docker_config]",
    "recipe[consul::install]",
    "recipe[consul::acl_nomad]",
    "recipe[consul::management_token]",
    "recipe[consul::agent_token]",
    "recipe[consul::tls]",
    "recipe[nomad::default]",
    "recipe[nomad::consul_token]",
    "recipe[nomad::tls]",
    "recipe[nomad::snapshot]",
    "recipe[openbao::default]"
  ],

  "normal": {
    "nomad": {
      "client_tags": {
        "node_pool": "core",
        "node_class": "core",
        "meta": { "role": "ingress", "zone": "rack-a", "public": true }
      }
    }
  },
  "override": {
    "set_fqdn": "mccoy",
    "consul": {
      "acl": {
        "provisioner": true
      }
    },
    "nomad": {
      "bind_addr": "192.168.68.63",
      "datacenter": "pi-dc",
      "server": {
        "enabled": true,
        "servers": [
          "192.168.68.60",
          "192.168.68.61",
          "192.168.68.63"
        ],
        "raft_multiplier": 2,
        "retry_interval": "15s",
        "retry_max": 5
      },

      "client": {
        "enabled": true,
        "node_class": "",
        "cni_path": "/opt/cni/bin",
        "host_volumes": []
      },
      "vault": {
        "enabled": true,
        "address": "https://mccoy:8200"
      },
      "consul": {
        "enabled": true,
        "address": "192.168.68.63:8500",
        "auto_advertise": true,
        "auto_join": true
      },

      "docker": {
        "allow_privileged": true,
        "volumes": { "enabled": true },
        "caps": ["NET_ADMIN"]
      },

      "telemetry": {
        "enabled": true,
        "collection_interval": "1s",
        "disable_hostname": true,
        "prometheus_metrics": true,
        "publish_allocation_metrics": true,
        "publish_node_metrics": true
      },

      "cni": {
        "enable": true,
        "path": "/opt/cni/bin",
        "version": "v1.6.2"
      },

      "acl": {
        "enabled": true,
        "bootstrap_this_node": true
      }
    }
  }
}

