{
  "run_list": [
    "recipe[pi_bootstrap::default]",
    "recipe[pi_bootstrap::firewall]",
    "recipe[pi_bootstrap::gdrive_mount]",
    "recipe[consul::install]",
    "recipe[consul::acl_nomad]",
    "recipe[consul::management_token]",
    "recipe[consul::agent_token]",
    "recipe[consul::tls]",
    "recipe[nomad::default]",
    "recipe[nomad::cni]",
    "recipe[nomad::consul_token]",
    "recipe[nomad::tls]"
  ],
  "normal": {
    "set_fqdn": "cabot",
    "nomad": {
      "client_tags": {
        "node_pool": "edge",
        "node_class": "utility",
        "meta": { "role": "utility", "zone": "rack-b", "public": false }
      },
      "bind_addr": "192.168.68.59",
      "datacenter": "pi-dc",

      "server": {
        "enabled": false,
        "servers": [
          "192.168.68.60",
          "192.168.68.61",
          "192.168.68.63"
        ],
        "raft_multiplier": 2,
        "retry_interval": "15s",
        "retry_max": 5
      },

      "client": {
        "enabled": true,
        "node_class": "",
        "cni_path": "/opt/cni/bin"
      },

      "consul": {
        "enabled": true,
        "address": "192.168.68.59:8500",
        "auto_advertise": true,
        "auto_join": true
      },

      "docker": {
        "allow_privileged": true,
        "volumes": { "enabled": true },
        "caps": ["NET_ADMIN"]
      },

      "telemetry": {
        "enabled": true,
        "collection_interval": "1s",
        "disable_hostname": true,
        "prometheus_metrics": true,
        "publish_allocation_metrics": true,
        "publish_node_metrics": true
      },

      "cni": {
        "enable": true,
        "path": "/opt/cni/bin",
        "version": "v1.6.2"
      },

      "acl": {
        "enabled": true,
        "bootstrap_this_node": false
      }
    }
  }
}

