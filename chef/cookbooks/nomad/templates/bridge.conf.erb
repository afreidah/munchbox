# --------------------------------------------------------------------
# Cookbook:: nomad
# Template:: bridge.conf.erb
# Purpose:: Sysctl for container/bridge networking on Linux hosts.
#           Required for Docker/CNI bridge traffic to traverse iptables.
# --------------------------------------------------------------------

# Enable IPv4 forwarding (required for container traffic)
net.ipv4.ip_forward = 1

# Ensure bridge traffic is visible to iptables/nftables
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.bridge.bridge-nf-call-arptables = 1
