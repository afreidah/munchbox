# --------------------------------------------------------------------
# Consul Agent Configuration (HCL)
# LAN-only (no WAN Serf / federation)
# --------------------------------------------------------------------

datacenter   = "<%= node['consul']['datacenter'] %>"
node_name    = "<%= node['consul']['node_name'] %>"
data_dir     = "<%= node['consul']['data_dir'] %>"

# Bind/advertise on your wired interface (e.g., eth0)
bind_addr      = "<%= node['consul']['bind_addr'] %>"
advertise_addr = "{{ GetInterfaceIP \"<%= node.dig('consul','interface') || 'eth0' %>\" }}"

leave_on_terminate   = true
rejoin_after_leave   = true
disable_update_check = true
log_level            = "<%= node['consul']['log_level'] || 'INFO' %>"

ui_config { enabled = <%= node['consul']['ui'] ? 'true' : 'false' %> }

# Keep API local; DNS open to LAN if you want clients to use Consul DNS
client_addr = "0.0.0.0"
addresses {
  # http = "127.0.0.1"
  http   = "0.0.0.0"
  https  = "0.0.0.0"
  dns    = "0.0.0.0"
}

# Ports: explicitly DISABLE serf_wan
ports {
  http     = 8500
  https    = 8501
  dns      = 8600
  serf_lan = 8301
  serf_wan = -1
  server   = 8300
  grpc     = 8502
  grpc_tls = 8503
}

# --------------------------------------------------------------------
# ACLs
# --------------------------------------------------------------------
acl {
  enabled                   = <%= node['consul']['acl']['enabled'] %>                 # Enforce Consul ACLs
  default_policy            = "<%= node.dig('consul','acl','default_policy') || 'deny' %>"        # 'deny' recommended (anonymous has no rights)
  down_policy               = "<%= node.dig('consul','acl','down_policy') || 'extend-cache' %>"   # Keep cached authorizations during leader loss
  enable_token_persistence  = <%= (node.dig('consul','acl','enable_token_persistence').nil? ? true : node['consul']['acl']['enable_token_persistence']) %>  # Persist set-agent-token across restarts

  # Tokens: only render what you’ve provided via attributes/data bags.
  # - agent:     required for each agent to write its own node/health/service info.
  # - default:   optional; set *only* if you want anonymous read access.
  # - replication: optional; used for ACL replication (leave unset unless you know you need it).
  <% agent       = node.dig('consul','acl','tokens','agent') %>
  <% default_tok = node.dig('consul','acl','tokens','default') %>
  <% replication = node.dig('consul','acl','tokens','replication') %>
  <% if agent || default_tok || replication %>
  tokens {
    <% if agent        %>agent       = "<%= agent %>"<% end %>
    <% if default_tok  %><%= agent ? "\n    " : "" %>default     = "<%= default_tok %>"<% end %>
    <% if replication  %><%= (agent || default_tok) ? "\n    " : "" %>replication = "<%= replication %>"<% end %>
  }
  <% end %>
}

# --------------------------------------------------------------------
# Gossip (Serf) Encryption
# --------------------------------------------------------------------
encrypt                 = "<%= @serf_key || node['consul']['serf_key'] %>"
encrypt_verify_incoming = true
encrypt_verify_outgoing = true

# --------------------------------------------------------------------
# Role: server or client
# --------------------------------------------------------------------
server = <%= node['consul']['server']['enable'] ? 'true' : 'false' %>
<% if node['consul']['server']['enable'] %>
bootstrap_expect = <%= node['consul']['server']['bootstrap_expect'] %>
autopilot {
  cleanup_dead_servers   = true
  last_contact_threshold = "200ms"
  max_trailing_logs      = 250
}
<% end %>

# --------------------------------------------------------------------
# Cluster Join (LAN only)
# List the LAN IPs/hostnames of your servers here.
# --------------------------------------------------------------------
<% if node['consul']['retry_join'] && !node['consul']['retry_join'].empty? %>
retry_join = <%= node['consul']['retry_join'].to_json %>
<% end %>

# NO WAN SETTINGS:
# (Do not set retry_join_wan or advertise_addr_wan anywhere.)

# --------------------------------------------------------------------
# DNS recursors — send to local Pi-hole (which forwards to Unbound)
# --------------------------------------------------------------------
recursors = <%= (node['consul']['recursors'] || ['127.0.0.1']).to_json %>

# Telemetry / Performance
telemetry   { prometheus_retention_time = "24h" }
performance { raft_multiplier = 1 }

# --------------------------------------------------------------------
# TLS Configuration (Consul 1.20+ style)
# --------------------------------------------------------------------
tls {
  # Defaults apply to all listeners unless overridden below
  defaults {
    ca_file   = "/opt/consul/tls/consul-agent-ca.pem"
    cert_file = "/opt/consul/tls/dc1-server-consul-0.pem"
    key_file  = "/opt/consul/tls/dc1-server-consul-0-key.pem"

    # These must live under `defaults` (or specific listener blocks)
    verify_incoming = true
    verify_outgoing = true
  }

  # Server↔server and agent RPC path
  internal_rpc {
    verify_server_hostname = true
  }

  # If you expose HTTPS (you currently have ports.http=8500 only; keep this if/when you enable https)
  # https {
  #   verify_incoming = true
  # }

  # If you use the gRPC TLS listener (ports.grpc_tls = 8503), hostname verification is covered by defaults.
  # Add a block only if you need to override defaults:
  # grpc {
  #   # e.g., verify_incoming = true
  # }
}
