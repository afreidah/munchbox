# --------------------------------------------------------------------
# Consul Agent Configuration (HCL)
# LAN-only (no WAN Serf / federation)
# --------------------------------------------------------------------

datacenter   = "<%= node['consul']['datacenter'] %>"
node_name    = "<%= node['consul']['node_name'] %>"
data_dir     = "<%= node['consul']['data_dir'] %>"

# Bind/advertise on your wired interface (e.g., eth0)
bind_addr      = "<%= node['consul']['bind_addr'] %>"
advertise_addr = "{{ GetInterfaceIP \"<%= node.dig('consul','interface') || 'eth0' %>\" }}"

leave_on_terminate   = true
rejoin_after_leave   = true
disable_update_check = true
log_level            = "<%= node['consul']['log_level'] || 'INFO' %>"

ui_config { enabled = <%= node['consul']['ui'] ? 'true' : 'false' %> }

# Keep API local; DNS open to LAN if you want clients to use Consul DNS
client_addr = "127.0.0.1"
addresses {
  http = "127.0.0.1"
  dns  = "0.0.0.0"
}

# Ports: explicitly DISABLE serf_wan
ports {
  http     = 8500
  dns      = 8600
  serf_lan = 8301
  serf_wan = -1     # <- disables WAN completely
  server   = 8300
  grpc_tls = 8503
}

# --------------------------------------------------------------------
# ACLs
# --------------------------------------------------------------------
acl {
  enabled                  = <%= node['consul']['acl']['enabled'] %>
  default_policy           = "deny"
  down_policy              = "extend-cache"
  enable_token_persistence = true
  <% agent   = node.dig('consul','acl','tokens','agent') %>
  <% default = node.dig('consul','acl','tokens','default') %>
  <% if agent || default %>
  tokens {
    <% if agent %>agent   = "<%= agent %>"<% end %>
    <% if default %><%= agent ? "\n    " : "" %>default = "<%= default %>"<% end %>
  }
  <% end %>
}

# --------------------------------------------------------------------
# Gossip (Serf) Encryption
# --------------------------------------------------------------------
encrypt                 = "<%= @serf_key || node['consul']['serf_key'] %>"
encrypt_verify_incoming = true
encrypt_verify_outgoing = true

# --------------------------------------------------------------------
# Role: server or client
# --------------------------------------------------------------------
server = <%= node['consul']['server']['enable'] ? 'true' : 'false' %>
<% if node['consul']['server']['enable'] %>
bootstrap_expect = <%= node['consul']['server']['bootstrap_expect'] %>
autopilot {
  cleanup_dead_servers   = true
  last_contact_threshold = "200ms"
  max_trailing_logs      = 250
}
<% end %>

# --------------------------------------------------------------------
# Cluster Join (LAN only)
# List the LAN IPs/hostnames of your servers here.
# --------------------------------------------------------------------
<% if node['consul']['retry_join'] && !node['consul']['retry_join'].empty? %>
retry_join = <%= node['consul']['retry_join'].to_json %>
<% end %>

# NO WAN SETTINGS:
# (Do not set retry_join_wan or advertise_addr_wan anywhere.)

# --------------------------------------------------------------------
# DNS recursors — send to local Pi-hole (which forwards to Unbound)
# --------------------------------------------------------------------
recursors = <%= (node['consul']['recursors'] || ['127.0.0.1']).to_json %>

# Telemetry / Performance
telemetry   { prometheus_retention_time = "24h" }
performance { raft_multiplier = 1 }
