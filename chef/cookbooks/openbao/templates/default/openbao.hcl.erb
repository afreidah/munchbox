# ------------------------------------------------------------------------------
# Cookbook:: openbao
# Template :: openbao.hcl.erb
#
# Bare-metal OpenBao (no KMS) — Raft storage + TLS listeners.
# Values come from resource variables; see openbao_configure.
# ------------------------------------------------------------------------------

# --- Storage (integrated Raft) ---
storage "raft" {
  path    = "<%= @storage_path %>"   # e.g., /opt/openbao/data
  node_id = "<%= @node_id %>"        # unique per node
}

# --- Listener (API + Cluster over TLS) ---
listener "tcp" {
  address         = "0.0.0.0:8200"    # API
  cluster_address = "0.0.0.0:8201"    # Raft/cluster
  tls_disable     = 0
  tls_cert_file       = "<%= @tls_cert %>"
  tls_key_file        = "<%= @tls_key %>"

  # Provide a client CA only if you want client-auth (mTLS) for the API.
  # If you include this without requiring client certs, it will verify when presented.
  # tls_client_ca_file  = "<%= @tls_ca %>"

  # Recommended hardening (uncomment if you want strict TLS):
  # tls_min_version = "tls12"
  # tls_require_and_verify_client_cert = true
}

# --- Addresses / UI ---
api_addr     = "https://<%= @hostname %>:8200"
cluster_addr = "https://<%= @hostname %>:8201"
ui           = true

# Optional: cluster metadata (handy if you’ll add more peers later)
# cluster_name = "dc1"

# Optional telemetry block for Prometheus scraping
# telemetry {
#   prometheus_retention_time = "24h"
# }
