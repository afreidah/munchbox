# frozen_string_literal: true

# ------------------------------------------------------------------------------
#  Gemfile — edo_openbao Cookbook Dev/Test Environment
# ------------------------------------------------------------------------------
#
#  Ruby version is locked to 3.3.6 for compatibility with current Chef, Kitchen,
#  and Cinc toolchain. Update with care and test all integrations if bumping Ruby.
#
#  Groups:
#    :development, :test — All gems here are only needed for authoring, testing,
#                          and CI. Nothing here is needed for Chef-Server use.
# ------------------------------------------------------------------------------

source 'https://rubygems.org'

ruby '3.3.6'

group :development, :test do
  # --- Chef/Cinc CLI tools ---
  gem 'chef', '~> 18.7.6'                 # Chef Infra Client (version 17.x for compatibility).
  gem 'knife-spork'                       # Workflow add-on for Knife, supports cookbook promotion.

  # --- Utilities & Ruby stdlib stuff ---
  gem 'archive-tar-minitar'               # Tarball archiving (used by some Chef tools)
  gem 'csv', require: false               # CSV parsing (future Ruby: explicit install required).
  gem 'syslog', '~> 0.3'                  # Syslog Ruby bindings (for syslog support).

  # --- CI & Notifications ---
  gem 'slack-notifier', require: false # Slack notifications for CI events (optional, but useful).

  # --- Testing ---
  gem 'berkshelf'                         # Berkshelf: dependency management for Chef cookbooks.
  gem 'inspec'                            # InSpec: compliance and integration testing.
  gem 'rspec', '~> 3.12'                  # RSpec: testing framework for Ruby (unit tests, etc.).
  gem 'rspec-core', '~> 3.12'             # RSpec core library (required by RSpec).
  gem 'rspec-expectations', '~> 3.12'     # RSpec expectations library (required by RSpec).
  gem 'rspec-mocks', '~> 3.12'            # RSpec mocks library (required by RSpec).
  gem 'simplecov'                         # Test coverage reporting.
  gem 'simplecov-console'                 # SimpleCov console formatter (for better output in CI).
  gem 'chefspec'                          # ChefSpec: unit testing framework for Chef cookbooks.
  gem 'guard'                             # Guard: file watcher for automatic test runs.
  gem 'guard-shell'                       # Guard shell plugin for running shell commands (e.g., ChefSpec).

  # --- Linting & Style ---
  gem 'cookstyle', '= 8.1.3' # current as of 2025‑06, gets bug‑fixes
  gem 'colorize'                          # Colored output (makes lint and test output easier to read).
  gem 'ruby-lsp'                          # Ruby Language Server Protocol support for IDEs/editors.
  gem 'syntax_tree'                       # Syntax tree parsing for Ruby (used by Cookstyle).

  # --- Test Kitchen & Drivers ---
  gem 'test-kitchen'                      # Test Kitchen core.
  gem 'kitchen-ec2'                       # EC2 driver for Kitchen.
  gem 'kitchen-inspec'                    # InSpec verifier for Kitchen.
  gem 'kitchen-transport-speedy'          # Speedy SSH transport for faster Kitchen EC2.
  gem 'listen'                            # File watcher for Test Kitchen (auto-reloads).

  # --- Build & Docs ---
  gem 'rake' # Standard build tasks.
end
