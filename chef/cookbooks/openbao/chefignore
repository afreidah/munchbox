# ---------------------------------------------------------------------------------
# chefignore
#
#  This file contains ignore patterns for files and directories that should not be
#  uploaded to Chef Infra Server or Supermarket.
#
#  Prevents unnecessary files from being included in cookbook uploads.
# ---------------------------------------------------------------------------------

# --- OS generated files ---
.DS_Store
ehthumbs.db
Icon?
nohup.out
Thumbs.db
.envrc

# --- Editor files ---
.#*
.project
.settings
*_flymake
*_flymake.*
*.sw[a-z]
*.tmproj
*~
\#*
REVISION
TAGS*
tmtags
.vscode
.editorconfig

# --- Testing files ---
.kitchen*
kitchen*.yml
Rakefile
spec/*
test/*

# --- Source control files ---
.git
.gitattributes
.gitconfig
.github/*
.gitignore
.gitkeep
.gitmodules
*/.git

# --- Bundler files ---
Gemfile
Gemfile.lock

# --- Policyfile files ---
Policyfile.rb
Policyfile.lock.json

# --- Documentation files ---
CODE_OF_CONDUCT*
CONTRIBUTING*
documentation/*
TESTING*
UPGRADING*

# --- Vagrant files ---
.vagrant
Vagrantfile
