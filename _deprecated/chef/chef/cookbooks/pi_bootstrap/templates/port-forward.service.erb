[Unit]
Description=PIA WireGuard Port Forwarding
After=network-online.target wg-quick@pia.service
Wants=network-online.target

[Service]
Type=simple
Environment="PIA_TOKEN=<%= @pia_token %>"
Environment="PF_GATEWAY=<%= @pf_gateway %>"
Environment="PF_HOSTNAME=<%= @pf_hostname %>"
WorkingDirectory=/root/manual-connections
ExecStart=/root/manual-connections/port_forwarding.sh
Restart=always

[Install]
WantedBy=multi-user.target
