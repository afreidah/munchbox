# ---------------------------------------------------------------------------------
# .gitignore
#
#  This file contains ignore patterns for files and directories that should not be
#  committed to version control in this Chef cookbook development environment.
#
#  Maintains a clean repository by ignoring local, build, and test artifacts.
# ---------------------------------------------------------------------------------

# --- Editor and OS-generated files ---
.vagrant
*~
*#
.#*
\#*#
.*.sw[a-z]
*.un~

# --- Ruby/Bundler artifacts ---
Gemfile.lock
gems.locked
bin/*
.bundle/*

# --- Test Kitchen files ---
.kitchen/
.kitchen.local.yml

# --- Chef-specific files ---
.zero-knife.rb
Policyfile.lock.json

# --- Tag files ---
*tags*

# --- Vendored cookbooks ---
*berks-cookbooks*

# --- Code coverage reports ---
*coverage*

# --- Test SQLite backups ---
files/backup/*
