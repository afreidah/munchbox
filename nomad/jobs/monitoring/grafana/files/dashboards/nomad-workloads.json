{
  "dashboard": {
    "uid": "munchbox-nomad-workloads",
    "title": "Nomad Workloads",
    "tags": ["nomad", "workloads", "jobs"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 2,
    "refresh": "10s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "type": "stat",
        "title": "",
        "gridPos": { "x": 0, "y": 0, "w": 3, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "count(up{job=\"nomad\"} == 1)",
            "legendFormat": ""
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "displayName": "Servers",
            "unit": "none",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 2 },
                { "color": "green", "value": 3 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "",
        "gridPos": { "x": 3, "y": 0, "w": 3, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "count(up{job=\"nomad-client\"} == 1)",
            "legendFormat": ""
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "displayName": "Clients",
            "unit": "none",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 3 },
                { "color": "green", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "",
        "gridPos": { "x": 6, "y": 0, "w": 3, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "count(count by (exported_job) (nomad_client_allocs_memory_rss))",
            "legendFormat": ""
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "displayName": "Jobs",
            "unit": "none",
            "color": { "fixedColor": "super-light-blue", "mode": "fixed" }
          }
        }
      },
      {
        "type": "stat",
        "title": "",
        "gridPos": { "x": 9, "y": 0, "w": 3, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "sum(nomad_client_allocations_running)",
            "legendFormat": ""
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "displayName": "Allocs",
            "unit": "none",
            "color": { "fixedColor": "super-light-blue", "mode": "fixed" }
          }
        }
      },
      {
        "type": "stat",
        "title": "",
        "gridPos": { "x": 12, "y": 0, "w": 3, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
            "legendFormat": ""
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "displayName": "Alerts",
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "dark-green", "value": null },
                { "color": "dark-yellow", "value": 1 },
                { "color": "dark-red", "value": 3 }
              ]
            }
          }
        }
      },
      {
        "type": "state-timeline",
        "title": "Nomad Servers",
        "gridPos": { "x": 15, "y": 0, "w": 9, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "up{job=\"nomad\"}",
            "legendFormat": "{{ "{{"  }}instance{{ "}}" }}"
          }
        ],
        "options": {
          "showValue": "never",
          "alignValue": "center",
          "mergeValues": true,
          "rowHeight": 0.8,
          "legend": {
            "displayMode": "list",
            "placement": "right",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 0 } } },
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 1 } } }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "custom": {
              "fillOpacity": 80
            }
          }
        }
      },
      {
        "type": "state-timeline",
        "title": "Nomad Clients",
        "gridPos": { "x": 0, "y": 3, "w": 24, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "up{job=\"nomad-client\"}",
            "legendFormat": "{{ "{{"  }}instance{{ "}}" }}"
          }
        ],
        "options": {
          "showValue": "never",
          "alignValue": "center",
          "mergeValues": true,
          "rowHeight": 0.8,
          "legend": {
            "displayMode": "list",
            "placement": "right",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 0 } } },
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 1 } } }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "custom": {
              "fillOpacity": 80
            }
          }
        }
      },
      {
        "type": "row",
        "title": "Job Resource Usage",
        "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "type": "timeseries",
        "title": "CPU Usage % of Allocation",
        "gridPos": { "x": 0, "y": 7, "w": 12, "h": 10 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "avg by (exported_job) (\n  nomad_client_allocs_cpu_total_ticks / nomad_client_allocs_cpu_allocated * 100\n)",
            "legendFormat": "{{ "{{"  }}exported_job{{ "}}" }}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "sortBy": "Last",
            "sortDesc": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10,
              "spanNulls": false,
              "drawStyle": "line",
              "gradientMode": "scheme"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Memory Usage % of Allocation",
        "gridPos": { "x": 12, "y": 7, "w": 12, "h": 10 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "avg by (exported_job) (\n  nomad_client_allocs_memory_rss / nomad_client_allocs_memory_allocated * 100\n)",
            "legendFormat": "{{ "{{"  }}exported_job{{ "}}" }}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "sortBy": "Last",
            "sortDesc": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10,
              "spanNulls": false,
              "drawStyle": "line",
              "gradientMode": "scheme"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "type": "row",
        "title": "Current Job Status",
        "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "type": "bargauge",
        "title": "CPU % by Job",
        "gridPos": { "x": 0, "y": 18, "w": 12, "h": 12 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "sort_desc(\n  avg by (exported_job) (\n    nomad_client_allocs_cpu_total_ticks / nomad_client_allocs_cpu_allocated * 100\n  )\n)",
            "legendFormat": "{{ "{{"  }}exported_job{{ "}}" }}",
            "instant": true
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "minVizWidth": 0,
          "minVizHeight": 10,
          "valueMode": "text",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 50 },
                { "color": "orange", "value": 70 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "type": "bargauge",
        "title": "Memory % by Job",
        "gridPos": { "x": 12, "y": 18, "w": 12, "h": 12 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "sort_desc(\n  avg by (exported_job) (\n    nomad_client_allocs_memory_rss / nomad_client_allocs_memory_allocated * 100\n  )\n)",
            "legendFormat": "{{ "{{"  }}exported_job{{ "}}" }}",
            "instant": true
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "minVizWidth": 0,
          "minVizHeight": 10,
          "valueMode": "text",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 50 },
                { "color": "orange", "value": 70 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "type": "row",
        "title": "Alerts",
        "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "type": "table",
        "title": "Active Alerts",
        "gridPos": { "x": 0, "y": 31, "w": 24, "h": 5 },
        "datasource": { "type": "prometheus", "uid": "bf4xwjsn0pqtca" },
        "targets": [
          {
            "expr": "ALERTS{alertstate=\"firing\"}",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true, "Value": true },
              "renameByName": {
                "alertname": "Alert",
                "alertstate": "State",
                "severity": "Severity",
                "instance": "Instance",
                "job": "Job"
              }
            }
          }
        ],
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "footer": {
            "show": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "left"
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Severity" },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background",
                    "mode": "gradient"
                  }
                },
                {
                  "id": "mappings",
                  "value": [
                    { "type": "value", "options": { "critical": { "color": "red" } } },
                    { "type": "value", "options": { "warning": { "color": "yellow" } } }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "overwrite": true
}
