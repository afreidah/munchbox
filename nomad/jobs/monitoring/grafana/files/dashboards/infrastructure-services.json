{
  "uid": "munchbox-infra-services",
    "title": "Infrastructure Services",
    "tags": ["infrastructure", "databases", "services"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "type": "row",
        "title": "Service Health",
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "type": "stat",
        "title": "PostgreSQL Up",
        "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "pg_up",
            "legendFormat": "PostgreSQL"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Redis Up",
        "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "redis_up",
            "legendFormat": "Redis"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Nextcloud Up",
        "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "nextcloud_up",
            "legendFormat": "Nextcloud"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Prometheus Targets Up",
        "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "count(up == 1)",
            "legendFormat": "Healthy"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "green", "value": 10 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Prometheus Targets Down",
        "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "count(up == 0) or vector(0)",
            "legendFormat": "Down"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "type": "row",
        "title": "PostgreSQL",
        "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "type": "stat",
        "title": "Database Size",
        "gridPos": { "x": 0, "y": 6, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(pg_database_size_bytes)",
            "legendFormat": "Total Size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1073741824 },
                { "color": "red", "value": 10737418240 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Active Connections",
        "gridPos": { "x": 6, "y": 6, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(pg_stat_activity_count)",
            "legendFormat": "Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 50 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Transactions per Second",
        "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*\"}[5m])",
            "legendFormat": "{{ `{{` }}datname{{ `}}` }} commits"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*\"}[5m])",
            "legendFormat": "{{ `{{` }}datname{{ `}}` }} rollbacks"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "type": "table",
        "title": "Database Sizes",
        "gridPos": { "x": 0, "y": 10, "w": 12, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "pg_database_size_bytes{datname!~\"template.*\"}",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
              "renameByName": { "datname": "Database", "Value": "Size" }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Database" },
              "properties": [{ "id": "unit", "value": "string" }]
            }
          ]
        }
      },
      {
        "type": "row",
        "title": "Redis",
        "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "type": "stat",
        "title": "Memory Used",
        "gridPos": { "x": 0, "y": 15, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "redis_memory_used_bytes",
            "legendFormat": "Memory"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 134217728 },
                { "color": "red", "value": 536870912 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Connected Clients",
        "gridPos": { "x": 4, "y": 15, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "redis_connected_clients",
            "legendFormat": "Clients"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 50 },
                { "color": "red", "value": 100 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Total Keys",
        "gridPos": { "x": 8, "y": 15, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(redis_db_keys)",
            "legendFormat": "Keys"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Redis Commands/sec",
        "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(redis_commands_processed_total[5m])",
            "legendFormat": "Commands/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "type": "gauge",
        "title": "Hit Rate",
        "gridPos": { "x": 0, "y": 19, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total) * 100",
            "legendFormat": "Hit Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 80 },
                { "color": "green", "value": 95 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Uptime",
        "gridPos": { "x": 6, "y": 19, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "redis_uptime_in_seconds",
            "legendFormat": "Uptime"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "type": "row",
        "title": "Nextcloud",
        "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "type": "stat",
        "title": "Total Users",
        "gridPos": { "x": 0, "y": 24, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "nextcloud_users_total",
            "legendFormat": "Users"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "fixedColor": "blue", "mode": "fixed" }
          }
        }
      },
      {
        "type": "stat",
        "title": "Total Files",
        "gridPos": { "x": 4, "y": 24, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "nextcloud_files_total",
            "legendFormat": "Files"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "fixedColor": "blue", "mode": "fixed" }
          }
        }
      },
      {
        "type": "stat",
        "title": "Free Space",
        "gridPos": { "x": 8, "y": 24, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "nextcloud_free_space_bytes",
            "legendFormat": "Free"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 53687091200 },
                { "color": "green", "value": 107374182400 }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Database Size",
        "gridPos": { "x": 12, "y": 24, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "nextcloud_database_size_bytes",
            "legendFormat": "DB Size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "type": "stat",
        "title": "Active Users (Today)",
        "gridPos": { "x": 16, "y": 24, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "nextcloud_active_users_daily_total",
            "legendFormat": "Active Today"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "fixedColor": "green", "mode": "fixed" }
          }
        }
      },
      {
        "type": "stat",
        "title": "Total Shares",
        "gridPos": { "x": 20, "y": 24, "w": 4, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(nextcloud_shares_total)",
            "legendFormat": "Shares"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          }
        }
      },
      {
        "type": "table",
        "title": "Nextcloud System Info",
        "gridPos": { "x": 0, "y": 28, "w": 12, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "nextcloud_system_info",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "service": true, "Value": true },
              "renameByName": { "version": "Nextcloud Version" }
            }
          }
        ]
      },
      {
        "type": "table",
        "title": "PHP Info",
        "gridPos": { "x": 12, "y": 28, "w": 12, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "nextcloud_php_info",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "service": true, "Value": true },
              "renameByName": { "version": "PHP Version" }
            }
          }
        ]
      }
  ]
}
