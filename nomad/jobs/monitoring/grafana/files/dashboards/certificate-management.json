{
  "uid": "munchbox-cert-management",
  "title": "Certificate Management",
  "tags": ["certificates", "vault", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Total Managed Certificates",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds)",
          "legendFormat": "Total"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Expiring < 7 Days",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds < (time() + 7*24*60*60)) or vector(0)",
          "legendFormat": "Expiring Soon"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Expiring < 30 Days",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds < (time() + 30*24*60*60)) or vector(0)",
          "legendFormat": "Expiring Soon"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Fingerprint Mismatches",
      "description": "Count of certs where disk and memory fingerprints differ",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(managed_cert_fingerprint_info{location=\"disk\"} unless on(instance, name, fingerprint) managed_cert_fingerprint_info{location=\"memory\"}) or vector(0)",
          "legendFormat": "Mismatches"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "table",
      "title": "Mismatched Certificates",
      "description": "Certificates where disk fingerprint doesn't match memory (service needs restart)",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "managed_cert_fingerprint_info{location=\"disk\"} unless on(instance, name, fingerprint) managed_cert_fingerprint_info{location=\"memory\"}",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "service": true,
              "location": true,
              "Value": true
            },
            "renameByName": {
              "instance": "Node",
              "name": "Certificate",
              "fingerprint": "Disk Fingerprint"
            },
            "indexByName": {
              "Node": 0,
              "Certificate": 1,
              "Disk Fingerprint": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        }
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          { "displayName": "Node", "desc": false }
        ]
      }
    },
    {
      "type": "row",
      "title": "Certificate Details",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "All Managed Certificates",
      "gridPos": { "x": 0, "y": 11, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "managed_cert_not_after_timestamp_seconds",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "service": true
            },
            "renameByName": {
              "instance": "Node",
              "name": "Certificate",
              "Value": "Expires (Unix)"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "Expires (Unix)",
              "operator": "*",
              "right": "1000"
            },
            "alias": "Expires",
            "replaceFields": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Expires (Unix)" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Expires" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          { "displayName": "Expires", "desc": false }
        ]
      }
    },
    {
      "type": "row",
      "title": "Certificate Expiry Timeline",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Days Until Expiry",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(managed_cert_not_after_timestamp_seconds - time()) / 86400",
          "legendFormat": "{{ "{{"  }}instance{{ "}}" }} - {{ "{{"  }}name{{ "}}" }}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["last"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "green", "value": 30 }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          }
        }
      }
    },
    {
      "type": "row",
      "title": "By Certificate Type",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Consul Certs",
      "gridPos": { "x": 0, "y": 31, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds{name=~\"consul.*\"})",
          "legendFormat": "Consul"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Nomad Certs",
      "gridPos": { "x": 6, "y": 31, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds{name=~\"nomad.*\"})",
          "legendFormat": "Nomad"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null }
            ]
          }
        }
      }
    },
    {
      "type": "piechart",
      "title": "Certificates by Type",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count by (name) (managed_cert_not_after_timestamp_seconds)",
          "legendFormat": "{{ "{{"  }}name{{ "}}" }}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": ["value"]
        },
        "pieType": "pie"
      }
    }
  ]
}
