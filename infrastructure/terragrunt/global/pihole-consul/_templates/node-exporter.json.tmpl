{
  "Node": "${host}",
  "Address": "${ip}",
  "NodeMeta": {
    "node_type": "raspberry-pi-zero",
    "role": "dns-server",
    "arch": "armv6"
  },
  "Service": {
    "ID": "node-exporter-${host}",
    "Service": "node-exporter",
    "Port": 9100,
    "Tags": ["monitoring", "external", "node-exporter", "${host}"],
    "Meta": {
      "node_type": "raspberry-pi-zero",
      "role": "dns-server",
      "host": "${host}"
    }
  },
  "Check": {
    "Node": "${host}",
    "CheckID": "node-exporter-${host}-metrics",
    "Name": "node-exporter /metrics reachable",
    "ServiceID": "node-exporter-${host}",
    "Definition": {
      "HTTP": "http://${ip}:9100/metrics",
      "Interval": "30s",
      "Timeout": "5s"
    }
  }
}
