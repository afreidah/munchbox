{
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds)",
          "legendFormat": "Total"
        }
      ],
      "title": "Total Managed Certificates",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds < (time() + 7*24*60*60)) or vector(0)",
          "legendFormat": "Expiring Soon"
        }
      ],
      "title": "Expiring < 7 Days",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds < (time() + 30*24*60*60)) or vector(0)",
          "legendFormat": "Expiring Soon"
        }
      ],
      "title": "Expiring < 30 Days",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Count of certs where disk and memory fingerprints differ",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "count(managed_cert_fingerprint_info{location=\"disk\"} unless on(instance, name, fingerprint) managed_cert_fingerprint_info{location=\"memory\"}) or vector(0)",
          "legendFormat": "Mismatches"
        }
      ],
      "title": "Fingerprint Mismatches",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Certificates where disk fingerprint doesn't match memory (service needs restart)",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Node"
          }
        ]
      },
      "targets": [
        {
          "expr": "managed_cert_fingerprint_info{location=\"disk\"} unless on(instance, name, fingerprint) managed_cert_fingerprint_info{location=\"memory\"}",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "title": "Mismatched Certificates",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "location": true,
              "service": true
            },
            "indexByName": {
              "Certificate": 1,
              "Disk Fingerprint": 2,
              "Node": 0
            },
            "renameByName": {
              "fingerprint": "Disk Fingerprint",
              "instance": "Node",
              "name": "Certificate"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "title": "Certificate Details",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Expires (Unix)"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Expires"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Expires"
          }
        ]
      },
      "targets": [
        {
          "expr": "managed_cert_not_after_timestamp_seconds",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "title": "All Managed Certificates",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "service": true
            },
            "renameByName": {
              "Value": "Expires (Unix)",
              "instance": "Node",
              "name": "Certificate"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Expires",
            "binary": {
              "left": "Expires (Unix)",
              "operator": "*",
              "right": "1000"
            },
            "mode": "binary",
            "replaceFields": false
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "title": "Certificate Expiry Timeline",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "unit": "d"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "options": {
        "legend": {
          "calcs": [
            "last"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "(managed_cert_not_after_timestamp_seconds - time()) / 86400",
          "legendFormat": "{{instance}} - {{name}}"
        }
      ],
      "title": "Days Until Expiry",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "title": "By Certificate Type",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 31
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds{name=~\"consul.*\"})",
          "legendFormat": "Consul"
        }
      ],
      "title": "Consul Certs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 31
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count(managed_cert_not_after_timestamp_seconds{name=~\"nomad.*\"})",
          "legendFormat": "Nomad"
        }
      ],
      "title": "Nomad Certs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "pieType": "pie"
      },
      "targets": [
        {
          "expr": "count by (name) (managed_cert_not_after_timestamp_seconds)",
          "legendFormat": "{{name}}"
        }
      ],
      "title": "Certificates by Type",
      "type": "piechart"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "certificates",
    "vault",
    "security"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Certificate Management",
  "uid": "munchbox-cert-management",
  "version": 1
}