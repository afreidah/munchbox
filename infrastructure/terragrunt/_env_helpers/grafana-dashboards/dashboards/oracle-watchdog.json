    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Consul connection and session heartbeat status per Oracle node",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Connected"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "text": "Down"
                      },
                      "1": {
                        "color": "green",
                        "text": "OK"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Session"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "text": "Inactive"
                      },
                      "1": {
                        "color": "green",
                        "text": "Active"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "pluginVersion": "12.4.1",
      "targets": [
        {
          "expr": "oracle_watchdog_consul_connected",
          "format": "table",
          "instant": true,
          "refId": "connected"
        },
        {
          "expr": "oracle_watchdog_session_active",
          "format": "table",
          "instant": true,
          "refId": "session"
        }
      ],
      "title": "Node Status",
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "instance"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "job 1": true,
              "job 2": true,
              "service 1": true,
              "service 2": true
            },
            "renameByName": {
              "Value #connected": "Connected",
              "Value #session": "Session",
              "instance": "Node"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
