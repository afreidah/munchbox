[Unit]
Description=ZFS Watcher - Pool Monitoring Daemon
Documentation=https://github.com/rouben/zfswatcher
After=network.target zfs.target

[Service]
Type=simple
User={{ zfswatcher_user }}
ExecStart={{ zfswatcher_install_dir }}/zfswatcher -c {{ zfswatcher_config_dir }}/zfswatcher.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zfswatcher

# Create log directory
ExecStartPre=/bin/mkdir -p /var/log/zfswatcher

[Install]
WantedBy=multi-user.target
