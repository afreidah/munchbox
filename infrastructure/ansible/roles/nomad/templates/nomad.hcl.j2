# -------------------------------------------------------------------------------
# Nomad Configuration
#
# Project: Munchbox / Author: Alex Freidah
#
# {% if 'nomad_servers' in group_names %}Server{% endif %}{% if 'nomad_clients' in group_names %}{% if 'nomad_servers' in group_names %}/{% endif %}Client{% endif %} configuration for {{ ansible_hostname }}. Managed by Ansible.
# -------------------------------------------------------------------------------
datacenter = "{{ nomad_datacenter }}"
region = "{{ nomad_region }}"
data_dir = "{{ nomad_data_dir }}"
log_level = "INFO"
bind_addr = "{{ nomad_bind_addr }}"
advertise {
  http = "{{ nomad_advertise_http }}"
  rpc  = "{{ nomad_advertise_rpc }}"
  serf = "{{ nomad_advertise_serf }}"
}
{% if 'nomad_servers' in group_names %}
# -------------------------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------------------------
server {
  enabled = true
  bootstrap_expect = {{ nomad_bootstrap_expect }}

{% if nomad_server_join | length > 0 %}
  server_join {
    retry_join = {{ nomad_server_join | to_json }}
  }
{% endif %}
}
{% endif %}
{% if 'nomad_clients' in group_names %}
# -------------------------------------------------------------------------------
# Client Configuration
# -------------------------------------------------------------------------------
client {
{% if 'ingress' in group_names or nomad_client_meta is defined %}
  meta {
{% if 'ingress' in group_names %}
    role = "ingress"
{% endif %}
{% if nomad_client_meta is defined %}
{% for key, value in nomad_client_meta.items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
{% endif %}
  }
{% endif %}
  enabled = true
  gc_disk_usage_threshold = {{ nomad_gc_disk_usage_threshold | default(80) }}
  gc_inode_usage_threshold = {{ nomad_gc_inode_usage_threshold | default(70) }}
{% if nomad_servers | length > 0 %}
  servers = {{ nomad_servers | to_json }}
{% endif %}
{% if nomad_network_interface %}
  network_interface = "{{ nomad_network_interface }}"
{% endif %}
}
{% endif %}
# -------------------------------------------------------------------------------
# Consul Integration
# -------------------------------------------------------------------------------
consul {
{% if nomad_consul_ssl | default(false) | bool %}
  verify_ssl = true
{% endif %}
{% if consul_acl_agent_token is defined %}
  token = "{{ consul_acl_agent_token }}"
{% endif %}
  address = "{{ nomad_consul_address }}"
  datacenter = "{{ nomad_consul_datacenter }}"
{% if nomad_consul_ssl | default(false) | bool %}
  ssl = true
  ca_file = "{{ nomad_consul_ca_file }}"
  cert_file = "{{ nomad_consul_cert_file }}"
  key_file = "{{ nomad_consul_key_file }}"
{% endif %}
}
# -------------------------------------------------------------------------------
# ACL Configuration
# -------------------------------------------------------------------------------
acl {
  enabled = {{ nomad_acl_enabled | lower }}
}
# -------------------------------------------------------------------------------
# TLS Configuration
# -------------------------------------------------------------------------------
tls {
  http = {{ nomad_tls_http | lower }}
  rpc  = {{ nomad_tls_rpc | lower }}
{% if nomad_tls_http | bool or nomad_tls_rpc | bool %}

  ca_file   = "{{ nomad_tls_ca_file }}"
  cert_file = "{{ nomad_tls_cert_file }}"
  key_file  = "{{ nomad_tls_key_file }}"

  verify_server_hostname = {{ nomad_tls_verify_server_hostname | lower }}
  verify_https_client    = {{ nomad_tls_verify_https_client | lower }}
{% endif %}
}
# -------------------------------------------------------------------------------
# Vault Integration
# -------------------------------------------------------------------------------
vault {
  default_identity {
    aud = ["vault.io"]
    ttl = "1h"
  }
  enabled = true
  address = "{{ vault_api_addr }}"
{% if nomad_vault_ca_file is defined %}
  ca_file = "{{ nomad_vault_ca_file }}"
{% endif %}
}
# -------------------------------------------------------------------------------
# Docker Plugin Configuration
# -------------------------------------------------------------------------------
plugin "docker" {
  config {
    allow_privileged = true
    allow_caps = ["audit_write", "chown", "dac_override", "fowner", "fsetid", "kill",
                  "mknod", "net_bind_service", "setfcap", "setgid", "setpcap", "setuid",
                  "sys_chroot", "net_admin", "net_raw"]
    volumes {
      enabled = true
    }
    gc {
      image       = true
      image_delay = "3m"
      container   = true
      dangling_containers {
        enabled        = true
        dry_run        = false
        period         = "5m"
        creation_grace = "5m"
      }
    }
  }
}

# -------------------------------------------------------------------------------
# Telemetry - Prometheus Metrics
# -------------------------------------------------------------------------------
telemetry {
  prometheus_metrics         = true
  disable_hostname           = false
  publish_allocation_metrics = true
  publish_node_metrics       = true
}
