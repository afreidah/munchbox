# -------------------------------------------------------------------------------
# Consul Configuration
#
# Project: Munchbox / Author: Alex Freidah
#
# {% if consul_server_enabled | bool %}Server{% else %}Client{% endif %} configuration for {{ ansible_hostname }}. Managed by Ansible.
# -------------------------------------------------------------------------------

datacenter = "{{ consul_datacenter }}"
node_name = "{{ inventory_hostname }}"
data_dir   = "{{ consul_data_dir }}"
bind_addr  = "{{ consul_bind_addr }}"
client_addr = "{{ consul_client_addr }}"

{% if consul_server_enabled | bool %}
# -------------------------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------------------------

server           = true
bootstrap_expect = {{ consul_bootstrap_expect }}

retry_join = {{ consul_retry_join | to_json }}

{% else %}
# -------------------------------------------------------------------------------
# Client Configuration
# -------------------------------------------------------------------------------

server = false

retry_join = {{ consul_retry_join | to_json }}

{% endif %}
# -------------------------------------------------------------------------------
# UI
# -------------------------------------------------------------------------------

ui_config {
  enabled = {{ consul_ui_enabled | lower }}
}

# -------------------------------------------------------------------------------
# Performance
# -------------------------------------------------------------------------------

performance {
  raft_multiplier = {{ consul_raft_multiplier }}
}

# -------------------------------------------------------------------------------
# Connect / Service Mesh
# -------------------------------------------------------------------------------

connect {
  enabled = {{ consul_connect_enabled | lower }}
}

# -------------------------------------------------------------------------------
# Ports
# -------------------------------------------------------------------------------

ports {
  dns       = {{ consul_ports.dns }}
  http      = {{ consul_ports.http }}
  https     = {{ consul_ports.https }}
  grpc      = {{ consul_ports.grpc }}
  grpc_tls  = {{ consul_ports.grpc_tls }}
  serf_lan  = {{ consul_ports.serf_lan }}
  serf_wan  = {{ consul_ports.serf_wan }}
  server    = {{ consul_ports.server }}
}

acl {
  enabled        = true
  default_policy = "deny"
  down_policy    = "extend-cache"
{% if consul_acl_agent_token is defined %}
  tokens {
    agent   = "{{ consul_acl_agent_token }}"
    default = "{{ consul_acl_default_token | default(consul_acl_agent_token) }}"
  }
{% endif %}
}

# -------------------------------------------------------------------------------
# Telemetry
# -------------------------------------------------------------------------------

telemetry {
  prometheus_retention_time = "{{ consul_telemetry_prometheus_retention_time | default('30s') }}"
  disable_hostname = {{ consul_telemetry_disable_hostname | default(false) | lower }}
}

{% if consul_tls_enabled | default(true) | bool %}
tls {
  defaults {
    ca_file   = "{{ consul_tls_ca_file }}"
    cert_file = "{{ consul_tls_cert_file }}"
    key_file  = "{{ consul_tls_key_file }}"

    verify_incoming = {{ consul_tls_verify_incoming | default(true) | lower }}
    verify_outgoing = {{ consul_tls_verify_outgoing | default(true) | lower }}
  }

  internal_rpc {
    verify_server_hostname = {{ consul_tls_verify_server_hostname | default(true) | lower }}
  }

  # Allow browsers to access HTTPS UI without client certificates
  https {
    verify_incoming = false
  }
}
{% endif %}
