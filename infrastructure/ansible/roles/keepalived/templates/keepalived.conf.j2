# -------------------------------------------------------------------------------
# Keepalived Configuration for Traefik HA
#
# Project: Munchbox / Author: Alex Freidah
#
# Node: {{ inventory_hostname }}
# Dual VIP configuration for active-active load distribution:
#   VIP1: {{ keepalived_vip1 }} (stabler primary, goren backup)
#   VIP2: {{ keepalived_vip2 }} (goren primary, stabler backup)
# -------------------------------------------------------------------------------

global_defs {
  router_id {{ keepalived_router_id }}
  script_user root
  enable_script_security
}

# Health check script for Traefik
vrrp_script check_traefik {
  script "{{ keepalived_check_script }}"
  interval {{ keepalived_check_interval }}
  weight {{ keepalived_check_weight }}
  fall {{ keepalived_check_fall }}
  rise {{ keepalived_check_rise }}
}

# VIP1: {{ keepalived_vip1 }} (stabler primary)
vrrp_instance VI_1 {
  state {{ 'MASTER' if inventory_hostname == 'stabler' else 'BACKUP' }}
  interface {{ keepalived_interface }}
  virtual_router_id 50
  priority {{ keepalived_vip1_priority }}
  advert_int 1
  nopreempt

  authentication {
    auth_type PASS
    auth_pass {{ keepalived_auth_pass_vip1 }}
  }

  virtual_ipaddress {
    {{ keepalived_vip1 }}/{{ keepalived_netmask }}
  }

  track_script {
    check_traefik
  }
}

# VIP2: {{ keepalived_vip2 }} (goren primary)
vrrp_instance VI_2 {
  state {{ 'MASTER' if inventory_hostname == 'goren' else 'BACKUP' }}
  interface {{ keepalived_interface }}
  virtual_router_id 51
  priority {{ keepalived_vip2_priority }}
  advert_int 1
  nopreempt

  authentication {
    auth_type PASS
    auth_pass {{ keepalived_auth_pass_vip2 }}
  }

  virtual_ipaddress {
    {{ keepalived_vip2 }}/{{ keepalived_netmask }}
  }

  track_script {
    check_traefik
  }
}
