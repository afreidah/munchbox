# -------------------------------------------------------------------------------
# WireGuard Server Configuration (Oracle nodes)
#
# Project: Munchbox / Author: Alex Freidah
# Generated by Ansible - do not edit manually
#
# Each Oracle node listens on its public IP:51820 and has two peers:
# goren and nc05. Both home ingresses dial outbound to this server.
# Goren's peer carries the home-network return route; nc05's peer
# only carries the direct goren↔nc05↔oracle WG addresses.
# -------------------------------------------------------------------------------

[Interface]
Address = {{ wireguard_server_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_private_key }}
MTU = {{ wireguard_mtu }}

# Open local iptables for inbound WG traffic on the public interface,
# and accept everything coming in over the WG interface itself (mesh traffic
# from goren + nc05 to nomad/consul/vault scrape endpoints, etc).
PostUp = iptables -I INPUT -p udp --dport {{ wireguard_port }} -j ACCEPT
PostUp = iptables -I INPUT -i {{ wireguard_interface }} -j ACCEPT
PostDown = iptables -D INPUT -p udp --dport {{ wireguard_port }} -j ACCEPT
PostDown = iptables -D INPUT -i {{ wireguard_interface }} -j ACCEPT

[Peer]
# goren — carries the 192.168.68.0/24 return route
PublicKey = {{ wireguard_pubkeys['goren'] }}
AllowedIPs = {{ wireguard_home_ingress_addresses.goren }}/32, 192.168.68.0/24

[Peer]
# nc05
PublicKey = {{ wireguard_pubkeys['nc05'] }}
AllowedIPs = {{ wireguard_home_ingress_addresses.nc05 }}/32
