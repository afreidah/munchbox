# -------------------------------------------------------------------------------
# WireGuard Server Configuration
#
# Project: Munchbox / Author: Alex Freidah
# Generated by Ansible - do not edit manually
# -------------------------------------------------------------------------------

[Interface]
Address = {{ wireguard_server_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_private_key }}

# NAT for clients to reach home network
PostUp = iptables -t nat -A POSTROUTING -s {{ wireguard_network }} -o {{ wireguard_nat_interface }} -j MASQUERADE
PostUp = iptables -A FORWARD -i {{ wireguard_interface }} -j ACCEPT
PostUp = iptables -A FORWARD -o {{ wireguard_interface }} -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -s {{ wireguard_network }} -o {{ wireguard_nat_interface }} -j MASQUERADE
PostDown = iptables -D FORWARD -i {{ wireguard_interface }} -j ACCEPT
PostDown = iptables -D FORWARD -o {{ wireguard_interface }} -j ACCEPT

# Peers are added below - run playbook with --tags wireguard-peers to update
{% for peer in wireguard_peers | default([]) %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.persistent_keepalive | default(false) %}
PersistentKeepalive = 25
{% endif %}
{% endfor %}
