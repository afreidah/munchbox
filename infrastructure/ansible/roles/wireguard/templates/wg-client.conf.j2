# -------------------------------------------------------------------------------
# WireGuard Client Configuration (home ingress nodes)
#
# Project: Munchbox / Author: Alex Freidah
# Generated by Ansible - do not edit manually
#
# Each home ingress dials outbound to all 4 Oracle servers. Goren
# additionally MASQUERADEs traffic from the WG subnet so oracle traffic
# bound for home LAN hosts (other than goren itself) can be forwarded
# without per-host static routes on the home LAN.
# -------------------------------------------------------------------------------

[Interface]
Address = {{ wireguard_client_address }}
PrivateKey = {{ wireguard_private_key }}
MTU = {{ wireguard_mtu }}

{% if wireguard_home_subnet_carrier | default(false) %}
# This ingress carries the 192.168.68.0/24 return route for oracle peers.
PostUp = iptables -t nat -A POSTROUTING -s 10.200.0.0/24 -o {{ wireguard_nat_interface }} -j MASQUERADE
PostDown = iptables -t nat -D POSTROUTING -s 10.200.0.0/24 -o {{ wireguard_nat_interface }} -j MASQUERADE
{% endif %}

{% for peer in wireguard_client_peers %}
[Peer]
# {{ peer.name }}
PublicKey = {{ wireguard_pubkeys[peer.name] }}
Endpoint = {{ peer.endpoint }}:{{ wireguard_port }}
AllowedIPs = {{ peer.wg_address }}/32
PersistentKeepalive = 25

{% endfor %}
