# Generated by Ansible - do not edit manually
# -------------------------------------------------------------------------------

[Interface]
Address = {{ wireguard_client_address | default('10.200.0.99/24') }}
PrivateKey = {{ wireguard_private_key }}

[Peer]
# Home WireGuard server
PublicKey = {{ wireguard_server_public_key | default('PLACEHOLDER') }}
Endpoint = {{ wireguard_server_endpoint | default('127.0.0.1') }}:{{ wireguard_port }}
AllowedIPs = {{ wireguard_server_allowed_networks | default(['10.200.0.0/24']) | join(', ') }}
PersistentKeepalive = 25
