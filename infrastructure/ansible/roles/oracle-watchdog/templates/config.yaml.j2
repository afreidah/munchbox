# Project: Munchbox / Author: Alex Freidah
#
# Generated by Ansible. Read by oracle-watchdog -mode monitor at startup.
# -------------------------------------------------------------------------------

# WireGuard endpoint resolver. When enabled, the monitor periodically re-
# resolves the WG server hostname and updates the kernel peer endpoint via
# netlink. Pairs with the wan_dns block on the agent (which keeps the
# Cloudflare A record in sync with the home WAN IP) so the tunnel survives
# residential ISP IP changes without manual intervention.
wireguard:
  enabled: {{ oracle_watchdog_wireguard_enabled | bool | lower }}
  interface: {{ oracle_watchdog_wireguard_interface }}
  peer_pubkey: "{{ oracle_watchdog_wireguard_peer_pubkey }}"
  endpoint_hostname: {{ oracle_watchdog_wireguard_endpoint_hostname }}
  endpoint_port: {{ oracle_watchdog_wireguard_endpoint_port }}
  resolve_interval: {{ oracle_watchdog_wireguard_resolve_interval }}
  stale_handshake_threshold: {{ oracle_watchdog_wireguard_stale_handshake_threshold }}
