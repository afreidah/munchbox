# -------------------------------------------------------------------------------
# Vault Cert Manager Configuration
#
# Project: Munchbox / Author: Alex Freidah
#
# Auto-generated by Ansible for {{ inventory_hostname }}. Do not edit manually.
# -------------------------------------------------------------------------------

vault:
  address: {{ vault_cert_manager_vault_addr }}
{% if vault_cert_manager_pki_mount is defined and vault_cert_manager_pki_mount != 'pki' %}
  pki_mount: {{ vault_cert_manager_pki_mount }}
{% endif %}
  auth:
    approle:
      role_id: "{{ vault_cert_manager_role_id }}"
      secret_id_file: {{ vault_cert_manager_config_dir }}/secret_id
{% if vault_cert_manager_approle_mount != 'approle' %}
      mount_path: {{ vault_cert_manager_approle_mount }}
{% endif %}

prometheus:
  port: {{ vault_cert_manager_metrics_port }}
  refresh_interval: {{ vault_cert_manager_metrics_refresh }}

logging:
  level: {{ vault_cert_manager_log_level }}
  format: {{ vault_cert_manager_log_format }}

certificates:
{% for cert in vault_cert_manager_certificates %}
  - name: {{ cert.name }}
    role: {{ cert.role }}
    common_name: {{ cert.common_name }}
    certificate: {{ cert.certificate }}
    key: {{ cert.key }}
{% if cert.ttl is defined %}
    ttl: {{ cert.ttl }}
{% endif %}
{% if cert.alt_names is defined and cert.alt_names | length > 0 %}
    alt_names:
{% for alt_name in cert.alt_names %}
      - {{ alt_name }}
{% endfor %}
{% endif %}
{% if cert.ip_sans is defined and cert.ip_sans | length > 0 %}
    ip_sans:
{% for ip in cert.ip_sans %}
      - {{ ip }}
{% endfor %}
{% endif %}
{% if cert.owner is defined %}
    owner: {{ cert.owner }}
{% endif %}
{% if cert.group is defined %}
    group: {{ cert.group }}
{% endif %}
{% if cert.on_change is defined %}
    on_change: "{{ cert.on_change }}"
{% endif %}
{% if cert.health_check is defined %}
    health_check:
      tcp: {{ cert.health_check.tcp }}
{% if cert.health_check.timeout is defined %}
      timeout: {{ cert.health_check.timeout }}
{% endif %}
{% endif %}
{% endfor %}
