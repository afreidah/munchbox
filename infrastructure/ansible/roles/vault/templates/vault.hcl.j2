# -------------------------------------------------------------------------------
# Vault Configuration
#
# Project: Munchbox / Author: Alex Freidah
#
# HA configuration with Consul storage backend. Managed by Ansible.
# -------------------------------------------------------------------------------

# -------------------------------------------------------------------------------
# Storage Backend - Consul
# -------------------------------------------------------------------------------

storage "consul" {
  address       = "{{ vault_consul_address }}"
  scheme        = "{{ vault_consul_scheme }}"
  path          = "{{ vault_consul_path }}"
{% if vault_consul_token is defined %}
  token         = "{{ vault_consul_token }}"
{% endif %}
{% if vault_consul_tls_ca_file is defined %}
  tls_ca_file   = "{{ vault_consul_tls_ca_file }}"
  tls_cert_file = "{{ vault_consul_tls_cert_file }}"
  tls_key_file  = "{{ vault_consul_tls_key_file }}"
{% endif %}
}

# -------------------------------------------------------------------------------
# Service Registration - Consul
# -------------------------------------------------------------------------------

service_registration "consul" {
{% if vault_consul_token is defined %}
  token         = "{{ vault_consul_token }}"
{% endif %}
{% if vault_consul_tls_ca_file is defined %}
  tls_ca_file   = "{{ vault_consul_tls_ca_file }}"
  tls_cert_file = "{{ vault_consul_tls_cert_file }}"
  tls_key_file  = "{{ vault_consul_tls_key_file }}"
{% endif %}
}

# -------------------------------------------------------------------------------
# Listener - HTTPS API
# -------------------------------------------------------------------------------

listener "tcp" {
  address         = "{{ vault_listener_address }}"
  cluster_address = "{{ vault_cluster_address }}"
  tls_disable     = {{ vault_tls_disable | lower }}
{% if not vault_tls_disable %}
  tls_cert_file   = "{{ vault_tls_cert_file }}"
  tls_key_file    = "{{ vault_tls_key_file }}"
{% endif %}
}

# -------------------------------------------------------------------------------
# Cluster Configuration
# -------------------------------------------------------------------------------

api_addr     = "{{ vault_api_addr }}"
cluster_addr = "{{ vault_cluster_addr }}"
cluster_name = "{{ vault_cluster_name }}"

# -------------------------------------------------------------------------------
# UI
# -------------------------------------------------------------------------------

ui = {{ vault_ui_enabled | lower }}

# -------------------------------------------------------------------------------
# Telemetry
# -------------------------------------------------------------------------------

telemetry {
  disable_hostname          = {{ vault_telemetry_disable_hostname | lower }}
  prometheus_retention_time = "{{ vault_telemetry_prometheus_retention_time }}"
}

# -------------------------------------------------------------------------------
# Auto-Unseal - OCI KMS
# -------------------------------------------------------------------------------

{% if vault_seal_type == "ocikms" %}
seal "ocikms" {
  key_id              = "{{ vault_ocikms_key_id }}"
  crypto_endpoint     = "{{ vault_ocikms_crypto_endpoint }}"
  management_endpoint = "{{ vault_ocikms_management_endpoint }}"
  auth_type_api_key   = {{ vault_ocikms_auth_type_api_key | default(true) | lower }}
}
{% endif %}

# -------------------------------------------------------------------------------
# Performance and Limits
# -------------------------------------------------------------------------------

disable_mlock = false
