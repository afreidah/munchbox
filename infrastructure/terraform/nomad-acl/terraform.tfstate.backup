            "job_acl": [],
            "name": "backup-worker",
            "rules_hcl": "# Read job/allocation state for backup metadata\nnamespace \"*\" {\n  policy = \"read\"\n}\n\n# Read node info\nnode {\n  policy = \"read\"\n}\n\n# Agent info for leader detection\nagent {\n  policy = \"read\"\n}\n\n# Operator read for snapshot operations\noperator {\n  policy = \"read\"\n}\n"
          },
