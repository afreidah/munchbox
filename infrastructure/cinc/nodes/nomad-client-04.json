{
  "name": "nomad-client-04",
  "chef_environment": "_default",
  "run_list": [
  "role[proxmox_vm]",
  "recipe[nvidia::install]"
]
,
  "normal": {
    "tags": [
      "nomad-client",
      "consul-client",
      "amd64",
      "proxmox-vm",
      "local-cloud",
      "nfs-mounter",
      "gdrive-mounter",
      "gpu",
      "zfs-pool-mounter"
    ],
    "global": {
      "dns_endpoint_ip": "192.168.68.73"
    },
    "nfs": {
      "client": {
        "extra_mounts": [
          {
            "mount_point": "/tank",
            "device": "192.168.68.69:/tank"
          }
        ]
      }
    },
    "consul": {
      "config": {
        "bind_addr": "192.168.68.73"
      }
    },
    "nomad": {
      "config": {
        "node_name": "nomad-client-04",
        "advertise_ip": "192.168.68.73",
        "client_meta": {
          "gpu": "true"
        }
      }
    },
    "docker": {
      "daemon": {
        "extra": {
          "runtimes": {
            "nvidia": {
              "args": [

              ],
              "path": "nvidia-container-runtime"
            }
          }
        }
      }
    },
    "vault_cert_manager": {
      "certificates": [
        {
          "name": "consul-client",
          "role": "consul-client",
          "common_name": "client.munchbox.consul",
          "certificate": "/etc/consul.d/tls/consul.crt",
          "key": "/etc/consul.d/tls/consul.key",
          "alt_names": [
            "localhost",
            "nomad-client-04",
            "nomad-client-04.munchbox.cc",
            "client.munchbox.consul"
          ],
          "ip_sans": [
            "192.168.68.73",
            "127.0.0.1"
          ],
          "owner": "consul",
          "group": "consul",
          "on_change": "systemctl reload consul",
          "health_check": {
            "tcp": "127.0.0.1:8501",
            "timeout": "5s"
          }
        },
        {
          "name": "nomad-client",
          "role": "nomad-client",
          "common_name": "client.global.nomad",
          "certificate": "/etc/nomad.d/tls/nomad.crt",
          "key": "/etc/nomad.d/tls/nomad.key",
          "alt_names": [
            "localhost",
            "nomad-client-04",
            "nomad-client-04.munchbox.cc",
            "client.global.nomad"
          ],
          "ip_sans": [
            "192.168.68.73",
            "127.0.0.1"
          ],
          "owner": "nomad",
          "group": "nomad",
          "on_change": "systemctl restart nomad",
          "health_check": {
            "tcp": "192.168.68.73:4646",
            "timeout": "5s"
          }
        }
      ]
    }
  }
}
