{
  "name": "rubirosa",
  "chef_environment": "_default",
  "run_list": [
    "role[proxmox_host]",
    "recipe[proxmox_host::pci_passthrough]",
    "recipe[proxmox_host::zfswatcher]",
    "recipe[nfs::server]",
    "role[disable_timesyncd]"
  ],
  "normal": {
    "tags": [
      "proxmox-host",
      "amd64",
      "local-cloud",
      "gpu",
      "zfs-pool-host",
      "nfs-mounter",
      "gdrive-mounter"
    ],
    "consul": {
      "config": {
        "node_name": "rubirosa",
        "bind_addr": "192.168.68.69"
      }
    },
    "proxmox_host": {
      "zfs_arc": {
        "max_bytes": 34359738368
      },
      "pci_passthrough": {
        "enabled": true,
        "device_ids": [
          "10de:25b0",
          "10de:2291"
        ]
      },
      "zfswatcher": {
        "enabled": true
      }
    },
    "nfs": {
      "server": {
        "exports": [
          {
            "path": "/tank",
            "clients": "192.168.68.0/24",
            "options": "rw,sync,no_subtree_check,no_root_squash"
          }
        ]
      }
    },
    "vault_cert_manager": {
      "certificates": [
        {
          "name": "consul-client",
          "role": "consul-client",
          "common_name": "client.munchbox.consul",
          "certificate": "/etc/consul.d/tls/consul.crt",
          "key": "/etc/consul.d/tls/consul.key",
          "ttl": "720h",
          "alt_names": [
            "localhost",
            "rubirosa",
            "rubirosa.munchbox.cc",
            "client.munchbox.consul"
          ],
          "ip_sans": [
            "192.168.68.69",
            "127.0.0.1"
          ],
          "owner": "consul",
          "group": "consul",
          "on_change": "systemctl reload consul",
          "health_check": {
            "tcp": "127.0.0.1:8501",
            "timeout": "5s"
          }
        }
      ]
    }
  }
}
