{
  "name": "goren",
  "chef_environment": "_default",
  "run_list": [
    "role[bare_metal_pi5]",
    "role[vault_server]",
    "recipe[wireguard::install]",
    "recipe[wireguard::configure]"
  ],
  "normal": {
    "tags": [
      "nomad-server",
      "nomad-client",
      "consul-server",
      "consul-client",
      "vault-server",
      "wireguard-node",
      "pi5",
      "arm64",
      "local-cloud",
      "nfs-mounter",
      "gdrive-mounter"
    ],
    "global": {
      "dns_endpoint_ip": "192.168.68.60"
    },
    "consul": {
      "config": {
        "bind_addr": "192.168.68.60",
        "gossip_lan_interval": "10s"
      }
    },
    "vault": {
      "config": {
        "advertise_ip": "192.168.68.60",
        "stale_paths": [
          "/etc/vault.d/vault.hcl.bak",
          "/etc/vault.d/vault.hcl.bak.20251125220954",
          "/etc/vault.d/vault.hcl.pre-tls.1764114982",
          "/etc/vault.d/vault.hcl.719198.2026-01-25@01:14:49~",
          "/etc/vault.d/tls/vault-csr.pem",
          "/etc/vault.d/tls/vault.crt.bak",
          "/etc/vault.d/tls/vault.key.bak"
        ]
      }
    },
    "nomad": {
      "config": {
        "node_name": "goren",
        "advertise_ip": "192.168.68.60",
        "server_join": [
          "192.168.68.61:4648",
          "192.168.68.58:4648"
        ],
        "vault_address": "https://192.168.68.60:8200",
        "node_class": "batch",
        "client_meta": {
          "role": "ingress",
          "vrrp_interface": "eth0",
          "zone": "rack-a"
        }
      }
    },
    "wireguard": {
      "interfaces": {
        "wg1": {
          "address": "10.201.0.2/32",
          "mtu": 1380,
          "vault_path": "secret/data/wireguard-v2/goren",
          "vault_field": "private_key",
          "post_up": [
            "iptables -t nat -A POSTROUTING -s 10.200.0.0/24 -o eth0 -j MASQUERADE",
            "tc qdisc replace dev %i root cake || true"
          ],
          "post_down": [
            "iptables -t nat -D POSTROUTING -s 10.200.0.0/24 -o eth0 -j MASQUERADE"
          ],
          "peers": [
            {
              "name": "oracle-node-1",
              "vault_path": "secret/data/wireguard-v2/oracle-node-1",
              "vault_field": "public_key",
              "allowed_ips": [
                "10.200.0.11/32"
              ],
              "endpoint": "132.226.87.58:51820",
              "persistent_keepalive": 25
            },
            {
              "name": "oracle-node-2",
              "vault_path": "secret/data/wireguard-v2/oracle-node-2",
              "vault_field": "public_key",
              "allowed_ips": [
                "10.200.0.12/32"
              ],
              "endpoint": "158.101.33.133:51820",
              "persistent_keepalive": 25
            },
            {
              "name": "oracle-arm-1",
              "vault_path": "secret/data/wireguard-v2/oracle-arm-1",
              "vault_field": "public_key",
              "allowed_ips": [
                "10.200.0.13/32"
              ],
              "endpoint": "132.226.26.135:51820",
              "persistent_keepalive": 25
            },
            {
              "name": "oracle-arm-2",
              "vault_path": "secret/data/wireguard-v2/oracle-arm-2",
              "vault_field": "public_key",
              "allowed_ips": [
                "10.200.0.14/32"
              ],
              "endpoint": "137.131.39.64:51820",
              "persistent_keepalive": 25
            }
          ]
        }
      }
    },
    "vault_cert_manager": {
      "certificates": [
        {
          "name": "consul-server",
          "role": "consul-server",
          "common_name": "server.munchbox.consul",
          "certificate": "/etc/consul.d/tls/consul.crt",
          "key": "/etc/consul.d/tls/consul.key",
          "alt_names": [
            "localhost",
            "goren",
            "goren.munchbox.cc",
            "server.munchbox.consul"
          ],
          "ip_sans": [
            "192.168.68.60",
            "127.0.0.1"
          ],
          "owner": "consul",
          "group": "consul",
          "on_change": "systemctl reload consul",
          "health_check": {
            "tcp": "127.0.0.1:8501",
            "timeout": "5s"
          }
        },
        {
          "name": "nomad-server",
          "role": "nomad-server",
          "common_name": "server.global.nomad",
          "certificate": "/etc/nomad.d/tls/nomad.crt",
          "key": "/etc/nomad.d/tls/nomad.key",
          "alt_names": [
            "localhost",
            "goren",
            "goren.munchbox.cc",
            "server.global.nomad",
            "client.global.nomad",
            "nomad.service.consul"
          ],
          "ip_sans": [
            "192.168.68.60",
            "127.0.0.1"
          ],
          "owner": "nomad",
          "group": "nomad",
          "on_change": "systemctl reload nomad",
          "health_check": {
            "tcp": "192.168.68.60:4646",
            "timeout": "5s"
          }
        },
        {
          "name": "vault-server",
          "role": "vault-server",
          "common_name": "goren.munchbox.cc",
          "certificate": "/etc/vault.d/tls/vault.crt",
          "key": "/etc/vault.d/tls/vault.key",
          "alt_names": [
            "localhost",
            "goren",
            "goren.munchbox.cc",
            "vault.munchbox.cc",
            "vault.service.consul"
          ],
          "ip_sans": [
            "192.168.68.60",
            "127.0.0.1"
          ],
          "owner": "vault",
          "group": "vault",
          "on_change": "systemctl reload vault",
          "health_check": {
            "tcp": "192.168.68.60:8200",
            "timeout": "5s"
          }
        }
      ]
    }
  }
}
