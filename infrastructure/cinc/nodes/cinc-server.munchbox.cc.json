{
  "name": "cinc-server.munchbox.cc",
  "chef_environment": "_default",
  "run_list": [
    "role[cinc_server_host]"
  ],
  "normal": {
    "tags": [
      "cinc-server",
      "consul-client",
      "amd64",
      "proxmox-vm",
      "local-cloud"
    ],
    "consul": {
      "config": {
        "node_name": "cinc-server",
        "bind_addr": "192.168.68.99",
        "retry_join": [
          "192.168.68.60",
          "192.168.68.61",
          "192.168.68.58"
        ]
      }
    },
    "vault_cert_manager": {
      "certificates": [
        {
          "name": "consul-client",
          "role": "consul-client",
          "common_name": "client.munchbox.consul",
          "certificate": "/etc/consul.d/tls/consul.crt",
          "key": "/etc/consul.d/tls/consul.key",
          "alt_names": [
            "localhost",
            "cinc-server",
            "cinc-server.munchbox.cc",
            "client.munchbox.consul"
          ],
          "ip_sans": [
            "192.168.68.99",
            "127.0.0.1"
          ],
          "owner": "consul",
          "group": "consul",
          "on_change": "systemctl reload consul",
          "health_check": {
            "tcp": "127.0.0.1:8501",
            "timeout": "5s"
          }
        }
      ]
    },
    "munchbox_base": {
      "vault_pki_trust": {
        "destinations": [
          "/usr/local/share/ca-certificates/vault-pki-ca.crt",
          {
            "path": "/etc/consul.d/tls/ca-chain.crt",
            "owner": "consul",
            "group": "consul",
            "mode": "0644",
            "chain": true
          }
        ],
        "reload_docker": false,
        "stale_paths": []
      }
    }
  }
}
