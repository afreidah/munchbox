{
  "name": "nomad-server-03",
  "chef_environment": "_default",
  "run_list": [
    "role[base]",
    "role[cinc_client]",
    "role[vault_agent]",
    "recipe[munchbox_base::sshd_ca]",
    "recipe[munchbox_base::vault_pki_trust]",
    "role[vault_cert_manager]",
    "role[consul_server]",
    "recipe[consul::dns]",
    "role[nomad_server]",
    "recipe[munchbox_base::resolv_conf]",
    "role[vault_server]",
    "role[vault_agent_coexist]"
  ],
  "normal": {
    "tags": [
      "nomad-server",
      "consul-server",
      "vault-server",
      "amd64",
      "proxmox-vm",
      "local-cloud",
      "nfs-mounter",
      "gdrive-mounter"
    ],
    "global": {
      "dns_endpoint_ip": "192.168.68.58"
    },
    "consul": {
      "config": {
        "bind_addr": "192.168.68.58",
        "retry_join": [
          "192.168.68.61",
          "192.168.68.60",
          "192.168.68.58"
        ]
      }
    },
    "vault": {
      "config": {
        "advertise_ip": "192.168.68.58",
        "stale_paths": [
          "/etc/vault.d/vault.hcl.bak",
          "/etc/vault.d/vault.hcl.bak.20251125220955",
          "/etc/vault.d/vault.hcl.pre-tls.1764114979",
          "/etc/vault.d/tls/vault-csr.pem",
          "/etc/vault.d/tls/vault.crt.bak",
          "/etc/vault.d/tls/vault.key.bak"
        ]
      }
    },
    "nomad": {
      "config": {
        "node_name": "nomad-server-03",
        "bind_addr": "0.0.0.0",
        "advertise_ip": "192.168.68.58",
        "server_join": [
          "192.168.68.61:4648",
          "192.168.68.60:4648"
        ],
        "vault_address": "https://192.168.68.61:8200",
        "stale_paths": [
          "/etc/nomad.d/nomad.hcl.bak",
          "/etc/nomad.d/nomad.hcl.broken",
          "/etc/nomad.d/consul_token.env",
          "/etc/nomad.d/010-client-tags.hcl",
          "/etc/systemd/system/nomad.service.d/10-consul-token.conf",
          "/etc/nomad.d/server.hcl"
        ]
      }
    },
    "vault_cert_manager": {
      "certificates": [
        {
          "name": "consul-server",
          "role": "consul-server",
          "common_name": "server.munchbox.consul",
          "certificate": "/etc/consul.d/tls/consul.crt",
          "key": "/etc/consul.d/tls/consul.key",
          "alt_names": [
            "localhost",
            "debian",
            "nomad-server-03",
            "nomad-server-03.munchbox.cc",
            "server.munchbox.consul"
          ],
          "ip_sans": [
            "192.168.68.58",
            "127.0.0.1"
          ],
          "owner": "consul",
          "group": "consul",
          "on_change": "systemctl reload consul",
          "health_check": {
            "tcp": "127.0.0.1:8501",
            "timeout": "5s"
          }
        },
        {
          "name": "nomad-server",
          "role": "nomad-server",
          "common_name": "server.global.nomad",
          "certificate": "/etc/nomad.d/tls/nomad.crt",
          "key": "/etc/nomad.d/tls/nomad.key",
          "alt_names": [
            "localhost",
            "debian",
            "nomad-server-03",
            "nomad-server-03.munchbox.cc",
            "server.global.nomad",
            "nomad.service.consul"
          ],
          "ip_sans": [
            "192.168.68.58",
            "127.0.0.1"
          ],
          "owner": "nomad",
          "group": "nomad",
          "on_change": "systemctl reload nomad",
          "health_check": {
            "tcp": "192.168.68.58:4646",
            "timeout": "5s"
          }
        },
        {
          "name": "vault-server",
          "role": "vault-server",
          "common_name": "nomad-server-03.munchbox.cc",
          "certificate": "/etc/vault.d/tls/vault.crt",
          "key": "/etc/vault.d/tls/vault.key",
          "alt_names": [
            "localhost",
            "debian",
            "nomad-server-03",
            "nomad-server-03.munchbox.cc",
            "vault.munchbox.cc",
            "vault.service.consul"
          ],
          "ip_sans": [
            "192.168.68.58",
            "127.0.0.1"
          ],
          "owner": "vault",
          "group": "vault",
          "on_change": "systemctl reload vault",
          "health_check": {
            "tcp": "192.168.68.58:8200",
            "timeout": "5s"
          }
        }
      ]
    }
  }
}
