# -------------------------------------------------------------------------------
# Munchbox .gitignore
#
# - Ignores Terraform and CDKTF state, logs, and generated files
# - Ignores Go build/test artifacts and coverage outputs
# - Ignores Chef, Nomad, and encrypted secrets
# -------------------------------------------------------------------------------

# --- Terraform & CDKTF ---
.terraform
.terragrunt-cache
cdktf.out
cdktf.log
*.tfstate
*.tfstate.*
*.tfstate.backup
generated

# --- Local Config Overrides ---
config.local.yaml
*.local.yaml
.env
.env.*

# --- Tags ---
*tags*

# --- Go Build Artifacts ---
*.exe
*.exe~
*.dll
*.so
*.dylib

# --- Go Test & Coverage Outputs ---
*.test
*.out

# --- Chef & Nomad ---
nomad-jobs/traefik-vars.hcl
encrypted_data_bag_secret
.kitchen/*
chef/cookbooks/vault/files/vault-armv6
chef/community-cookbooks/*

nomad-app
cdktf/bin/*

*.swo
*.swp
*.nomad-github-token
AGENTS.md
berks-cookbooks
*semgrep*
*tfvars*
munchbox-env.sh

# --- Secrets & Credentials ---
bootstrap-token.json
.bitwarden/
*.pem
*.key
*secret*.json
!*secret*.tf
