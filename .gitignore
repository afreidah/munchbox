# -------------------------------------------------------------------------------
# Munchbox .gitignore
#
# - Ignores Terraform and CDKTF state, logs, and generated files
# - Ignores Go build/test artifacts and coverage outputs
# - Ignores Chef, Nomad, and encrypted secrets
# -------------------------------------------------------------------------------

# --- Terraform & CDKTF ---
.terraform
.terragrunt-cache
cdktf.out
cdktf.log
*.tfstate
*.tfstate.*
*.tfstate.backup
generated

# --- Local Config Overrides ---
config.local.yaml
*.local.yaml
.env
.env.*

# --- Tags ---
*tags*

# --- Go Build Artifacts ---
*.exe
*.exe~
*.dll
*.so
*.dylib

# --- Go Test & Coverage Outputs ---
*.test
*.out

# --- Chef & Nomad ---
nomad-jobs/traefik-vars.hcl
encrypted_data_bag_secret
.kitchen/*
chef/cookbooks/vault/files/vault-armv6
chef/community-cookbooks/*

nomad-app
cdktf/bin/*

*.swo
*.swp
*.nomad-github-token
AGENTS.md
berks-cookbooks
*semgrep*
*tfvars*

# --- Terraform provider lock files ---
# Versions are pinned in required_providers, which is what reproducibility
# rests on. The lock file only adds per-platform hash verification, and on a
# mixed amd64/arm64 runner that produces checksum failures instead of safety.
.terraform.lock.hcl

# --- Secrets & Credentials ---
bootstrap-token.json
.bitwarden/
*.pem
*.key
*secret*.json
!*secret*.tf
