#!/bin/bash
set -e

# Complete Traefik v2.11 -> v3.5.2 Migration Setup Script
# This script handles all pre-migration setup and the first safe steps

echo "Starting Traefik v2.11 -> v3.5.2 Migration Setup"
echo "=================================================="

# Check if CONSUL_HTTP_ADDR is set
if [ -z "$CONSUL_HTTP_ADDR" ]; then
    export CONSUL_HTTP_ADDR="http://stabler:8500"
    echo "INFO: Set CONSUL_HTTP_ADDR to $CONSUL_HTTP_ADDR"
fi

echo "Using Consul at: $CONSUL_HTTP_ADDR"

# Function to check if consul is reachable
check_consul() {
    echo "Checking Consul connectivity..."
    if consul info > /dev/null 2>&1; then
        echo "SUCCESS: Consul is reachable"
    else
        echo "ERROR: Cannot reach Consul at $CONSUL_HTTP_ADDR"
        echo "       Please ensure Consul is running and accessible"
        exit 1
    fi
}

# Function to set Consul KV with error handling
set_kv() {
    local key="$1"
    local value="$2"
    echo "  Setting: $key"
    if consul kv put "$key" "$value" > /dev/null 2>&1; then
        echo "    SUCCESS"
    else
        echo "    ERROR: Failed to set $key"
        return 1
    fi
}

echo
echo "Phase 1: Populating Consul KV Store"
echo "===================================="

check_consul

echo "Setting up Traefik middleware configurations..."

# Basic Auth Middleware (encoded: admin:admin)
set_kv "traefik/http/middlewares/auth-basic/basicauth/users" "admin:\$2y\$10\$8eKdKzFj7n7qLVKJKlJZiOfxbVVjKVHKBrBNaJGk6gJx4v3qZsQ4G"

# IP Allow List for local network
set_kv "traefik/http/middlewares/local-only/ipallowlist/sourcerange" "192.168.68.0/24,127.0.0.1/32,10.0.0.0/8"

# Security Headers Middleware
set_kv "traefik/http/middlewares/security-headers/headers/customrequestheaders/X-Forwarded-Proto" "https"
set_kv "traefik/http/middlewares/security-headers/headers/customresponseheaders/X-Frame-Options" "DENY"
set_kv "traefik/http/middlewares/security-headers/headers/customresponseheaders/X-Content-Type-Options" "nosniff"
set_kv "traefik/http/middlewares/security-headers/headers/customresponseheaders/Referrer-Policy" "strict-origin-when-cross-origin"

# HTTPS Redirect Middleware
set_kv "traefik/http/middlewares/https-redirect/redirectscheme/scheme" "https"
set_kv "traefik/http/middlewares/https-redirect/redirectscheme/permanent" "true"

# Rate Limiting Middleware
set_kv "traefik/http/middlewares/rate-limit/ratelimit/burst" "100"
set_kv "traefik/http/middlewares/rate-limit/ratelimit/average" "50"

# Strip API Prefix Middleware
set_kv "traefik/http/middlewares/api-strip/stripprefix/prefixes" "/api"

echo
echo "Setting up system configuration..."

# ACME/TLS Configuration
set_kv "traefik/acme/email" "alex@alexfreidah.com"

# Timezone for container scheduling
set_kv "system/timezone" "America/Los_Angeles"

# Docker registry configuration
set_kv "docker/registry/url" "192.168.68.63:5000"

# Network configuration
set_kv "network/cluster/cidr" "192.168.68.0/24"
set_kv "network/cluster/gateway" "192.168.68.1"

# Monitoring endpoints
set_kv "monitoring/alertmanager/webhook" "https://hooks.slack.com/services/your/slack/webhook"

echo
echo "Setting up service discovery tokens..."

# Prometheus service discovery token (this will be used for dynamic SD)
set_kv "prometheus/sd/token" "prometheus-sd-token-$(date +%s)"

# System backup configurations
set_kv "system-snapshots/consul/enabled" "true"
set_kv "system-snapshots/consul/schedule" "0 2 * * *"  # Daily at 2 AM
set_kv "system-snapshots/nomad/enabled" "true"
set_kv "system-snapshots/nomad/schedule" "0 3 * * *"   # Daily at 3 AM

# Dashboard routes (these will be moved from static to dynamic config)
set_kv "traefik/http/routers/dashboard/rule" "Host(\`traefik.munchbox\`) && (PathPrefix(\`/api\`) || PathPrefix(\`/dashboard\`))"
set_kv "traefik/http/routers/dashboard/entrypoints" "web,websecure"
set_kv "traefik/http/routers/dashboard/middlewares" "auth-basic,security-headers"
set_kv "traefik/http/routers/dashboard/service" "api@internal"
set_kv "traefik/http/routers/dashboard/tls/certresolver" "letsencrypt"

echo "SUCCESS: Consul KV setup complete!"

echo
echo "Phase 2: Verifying Current System"
echo "=================================="

# Check current Traefik status
echo "Checking current Traefik deployment..."
if nomad job status traefik > /dev/null 2>&1; then
    echo "SUCCESS: Current Traefik v2.11 is running"
    echo "Current Traefik status:"
    nomad job status traefik | grep -E "(Status|Running|Failed)"
else
    echo "WARNING: No existing Traefik job found - this might be a fresh setup"
fi

# Check current services
echo
echo "Current Consul services:"
consul catalog services | head -10
echo "... (showing first 10 services)"

# Test current resume site
echo
echo "Testing current resume site accessibility..."
if curl -s -f https://resume.munchbox/ > /dev/null 2>&1; then
    echo "SUCCESS: resume.munchbox is accessible"
else
    echo "WARNING: resume.munchbox is not accessible - check current setup"
fi

if curl -s -f https://resume.alexfreidah.com/ > /dev/null 2>&1; then
    echo "SUCCESS: resume.alexfreidah.com is accessible"
else
    echo "WARNING: resume.alexfreidah.com is not accessible - check current setup"
fi

echo
echo "Phase 3: Ready for Safe Migration Steps"
echo "======================================="

echo "SUCCESS: Pre-migration setup complete! Now you can safely proceed with:"
echo
echo "STEP 1: Update resume site with v3 tags:"
echo "    cd cdktf/munchbox-core"
echo "    go run . -jobs nginx-resume-hostfile"
echo
echo "STEP 2: Deploy Traefik v3.5.2 side-by-side:"
echo "    go run . -jobs traefik-v2"
echo
echo "STEP 3: Test new Traefik v3 (will be on different ports):"
echo "    curl http://192.168.68.63:8082/ping"
echo "    curl http://192.168.68.63:8082/api/http/services"
echo
echo "STEP 4: Test resume routing through new Traefik:"
echo "    curl -H \"Host: resume.munchbox\" http://192.168.68.63:81/"
echo "    curl -H \"Host: resume.alexfreidah.com\" http://192.168.68.63:81/"
echo
echo "SAFETY NOTES:"
echo "  * Your current Traefik v2.11 keeps running on ports 80/8080"
echo "  * New Traefik v3.5.2 will run on ports 81/8082 (no conflicts)"
echo "  * Resume site will work with both during transition"
echo "  * Easy rollback: just stop the new traefik-v2 job"
echo
echo "Ready to proceed? Run the commands above in order!"
echo
echo "For detailed steps and service tagging examples, see:"
echo "  * MIGRATION-STEPS.md"
echo "  * SERVICE-TAGGING-EXAMPLES.md"
echo
echo "Migration foundation is set up successfully!"
