# .trivyignore for docker/ops-build-image
# This file tells Trivy to ignore specific CVEs that cannot be fixed or are low-risk

# ==============================================================================
# Python 3.13 - Waiting for Debian security update
# ==============================================================================
CVE-2025-8194  # cpython: infinite loop when parsing a tarfile - no fix available yet

# ==============================================================================
